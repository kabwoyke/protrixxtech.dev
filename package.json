{
  "name": "protrixx-tech-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website for Protrixx Tech Solutions — https://www.protrixxtechsolutions.dev/",
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/build.mjs",
    "build:css": "tailwindcss -i ./src/css/styles.css -o ./dist/css/styles.css --minify",
    "build": "npm run build:pages && npm run build:css",
    "watch:css": "tailwindcss -i ./src/css/styles.css -o ./dist/css/styles.css --watch",
    "serve": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-static": "^1.52.0",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=18"
  }
}
